# Server & Dev Ports
APP_PORT=3000
DEV_CLIENT_PORT=5173

# NAS File Permissions (Docker user: "${PUID}:${PGID}")
# Recommended values by host OS / NAS (run `id` or `id <user>` on Linux/NAS to verify):
# - Windows (Docker Desktop): PUID=0, PGID=0 (NTFS bind mounts inherit Windows user ownership; avoids UAC/EACCES issues)
# - Linux (desktop/server):   PUID=1000, PGID=1000 (match `id -u` / `id -g` of the host folder owner)
# - QNAP NAS (QTS/QuTS hero): PUID=1000, PGID=100 (or PUID=0, PGID=0 for admin; PGID=100 is QNAP's `everyone` group)
# - Synology NAS (DSM):       PUID=1026, PGID=100 (first admin-created user + `users` group)
# - Unraid:                   PUID=99, PGID=100 (`nobody:users`)
# - TrueNAS SCALE:            PUID=568, PGID=568 (`apps:apps` or your dataset owner UID/GID)
PUID=1000
PGID=1000

# Mount Paths (shared by native dev and Docker Compose)
CONFIG_DIR=./data/config
INPUT_DIR=./data/input
BACKUP_DIR=./data/backup
OUTPUT_MOVIES_DIR=./data/output/movies
OUTPUT_ANIMATED_MOVIES_DIR=./data/output/animated-movies
OUTPUT_TV_SHOWS_DIR=./data/output/tv-shows
OUTPUT_ANIMATED_SERIES_DIR=./data/output/animated-series

# Optional Metadata API Keys (public IMDb Suggestions and TVmaze work without keys)
OMDB_API_KEY=
TVDB_API_KEY=
